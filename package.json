{
  "name": "fig-gen",
  "version": "0.3.0",
  "type": "module",
  "description": "Paper-quality hardware figures (datapath, FSM, timing, micro-architecture) from typed JSON, with RTL cross-checks.",
  "license": "MIT",
  "bin": {
    "fig-gen": "./bin/fig-gen.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "doctor": "node bin/fig-gen.mjs doctor"
  },
  "dependencies": {
    "@fontsource/arimo": "5.3.0",
    "@fontsource/libertinus-serif": "5.3.0",
    "@fontsource/tinos": "5.3.0",
    "ajv": "8.20.0",
    "opentype.js": "2.0.0",
    "pdfkit": "0.20.2",
    "svg-to-pdfkit": "0.1.8",
    "wavedrom": "3.7.0"
  },
  "optionalDependencies": {
    "elkjs": "0.12.0"
  }
}
