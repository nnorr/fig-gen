{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fig-gen.local/schemas/receipt.schema.json",
  "title": "fig-gen delivery receipt (schema_version 1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "figure",
    "tool",
    "variants",
    "checks",
    "evidence",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "fig-gen-receipt"
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "spec_sha256",
        "spec_bytes"
      ],
      "properties": {
        "type": {
          "enum": [
            "datapath",
            "fsm",
            "timing",
            "microarch"
          ]
        },
        "spec_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "spec_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "node"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family",
              "sha256"
            ],
            "properties": {
              "family": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "profile_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "svg",
          "min_font_pt",
          "min_stroke_pt",
          "svg_lint"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "svg": {
            "$ref": "#/$defs/artifact"
          },
          "pdf": {
            "allOf": [
              {
                "$ref": "#/$defs/artifact"
              }
            ],
            "required": [
              "fonts_present"
            ],
            "properties": {
              "fonts_present": {
                "const": false
              }
            },
            "unevaluatedProperties": false
          },
          "preview": {
            "description": "PNG preview of the SVG rasterised by headless Chrome (deliver --preview).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes",
              "scale"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "min_font_pt": {
            "type": "number"
          },
          "min_stroke_pt": {
            "type": "number"
          },
          "short_labels_used": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "route": {
            "description": "Routing quality of this variant (SPEC §9.4): straight data nets, jogs and wire crossings per net class.",
            "type": "object",
            "properties": {
              "data_nets_straight": {
                "type": "integer",
                "minimum": 0
              },
              "data_nets_total": {
                "type": "integer",
                "minimum": 0
              },
              "data_jogs_redundant": {
                "description": "Redundant jogs on data wires. Paper blocks delivery on any (route/data-jog is an error), so a paper receipt records 0; a study receipt may record the warned count.",
                "type": "integer",
                "minimum": 0
              },
              "data_bends_unavoidable": {
                "type": "integer",
                "minimum": 0
              },
              "crossings": {
                "type": "object"
              },
              "edge_hugging": {
                "description": "Wires running along a block edge. Paper blocks delivery on any (route/edge-hugging is an error), so a paper receipt records 0; a study receipt may record the warned count.",
                "type": "integer",
                "minimum": 0
              },
              "data_bends": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "wire",
                    "justification"
                  ],
                  "properties": {
                    "wire": {
                      "type": "string"
                    },
                    "net": {
                      "type": "string"
                    },
                    "bends": {
                      "type": "integer"
                    },
                    "justification": {
                      "description": "Why the bend remains; null for an avoidable bend, which is reported as route/data-jog (an error in paper, a warning in study).",
                      "anyOf": [
                        { "type": "string", "minLength": 1 },
                        { "type": "null" }
                      ]
                    }
                  }
                }
              },
              "connectivity": {
                "description": "Exact connectivity of the final SVG geometry (wire/detached, wire/touching, symbol/bubble-detached).",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "wire_ends_checked",
                  "wire_detached",
                  "wire_touching",
                  "bubbles_checked",
                  "bubble_detached"
                ],
                "properties": {
                  "wire_ends_checked": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "wire_detached": {
                    "const": 0
                  },
                  "wire_touching": {
                    "const": 0
                  },
                  "junctions_checked": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "bubbles_checked": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "bubble_detached": {
                    "const": 0
                  },
                  "dots_checked": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "dot_near_arrow": {
                    "description": "route/dot-near-arrow: junction dots closer than route.dot_arrow_clearance to an arrowhead base or pin anchor.",
                    "const": 0
                  },
                  "strokes_checked": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "stroke_nonuniform": {
                    "description": "net/stroke-uniform: net paths or wire stubs not drawn at stroke.wire.",
                    "const": 0
                  },
                  "arrows_checked": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "arrow_nonuniform": {
                    "description": "arrow/nonuniform: arrowheads whose length or width differs from the skin arrow geometry.",
                    "const": 0
                  }
                }
              }
            }
          },
          "svg_lint": {
            "const": "pass"
          }
        }
      }
    },
    "variant_status": {
      "description": "Outcome per requested variant. 2col must be delivered; 1col is best effort and may be skipped with the reason and measured values.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "delivered",
              "skipped"
            ]
          },
          "reason": {
            "type": "string"
          },
          "measured": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "skipped"
                }
              }
            },
            "then": {
              "required": [
                "reason",
                "measured"
              ]
            }
          }
        ]
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codes_run",
        "errors",
        "warnings"
      ],
      "properties": {
        "codes_run": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "const": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "quality": {
          "enum": [
            "paper",
            "draft",
            "study"
          ]
        }
      }
    },
    "source_pins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "verified"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "verified": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidence": {
      "description": "Origin of every file the verification relied on. Files inside the fig-gen installation, tests/fixtures or a fig-gen work directory are never accepted (evidence/self-authored).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path",
          "sha256",
          "repository"
        ],
        "properties": {
          "role": {
            "enum": [
              "rtl",
              "netlist",
              "doc",
              "vcd",
              "stimulus",
              "stub-auto",
              "stub-user"
            ]
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "counts_as_evidence": {
            "type": "boolean"
          },
          "repository": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "root",
                  "revision",
                  "dirty"
                ],
                "properties": {
                  "root": {
                    "type": "string"
                  },
                  "revision": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "dirty": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "enum": [
                    "stub-auto",
                    "stub-user",
                    "stimulus"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "counts_as_evidence": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    },
    "rtl": {
      "$ref": "#/$defs/rtl_evidence"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "doc_facts": {
      "description": "Doc-grounded facts checked against every document of the pinned revision (SPEC §7.4): supporting sources, and for conflicts the user-chosen authority and the overridden sources.",
      "type": "object",
      "required": [
        "scanned_files",
        "facts"
      ],
      "properties": {
        "scanned_files": {
          "type": "integer",
          "minimum": 0
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "block",
              "attribute",
              "figure_value",
              "supporting",
              "overridden"
            ],
            "properties": {
              "block": {
                "type": "string"
              },
              "attribute": {
                "enum": [
                  "slot",
                  "instance",
                  "base",
                  "window",
                  "irq"
                ]
              },
              "figure_value": {
                "type": "string"
              },
              "supporting": {
                "type": "array"
              },
              "overridden": {
                "type": "array"
              },
              "authority": {
                "type": "object",
                "required": [
                  "file",
                  "reason"
                ]
              }
            }
          }
        }
      }
    },
    "function_evidence": {
      "description": "Vocabulary names justified by cited RTL structure (label/function-justification).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          },
          "rtl": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "description": "Completeness against the declared RTL scope (coverage/dropped-hardware): delivery requires everything in scope to be represented.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "totals",
        "regions"
      ],
      "properties": {
        "scope": {
          "type": "object"
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registers",
            "instances",
            "nets",
            "transfers"
          ],
          "properties": {
            "registers": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "covered",
                "total"
              ],
              "properties": {
                "covered": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "instances": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "covered",
                "total"
              ],
              "properties": {
                "covered": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "nets": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "covered",
                "total"
              ],
              "properties": {
                "covered": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "memories": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "covered",
                "total"
              ],
              "properties": {
                "covered": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "transfers": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "represented",
                "total"
              ],
              "properties": {
                "represented": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "registers",
              "instances",
              "nets"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "level": {
                "type": "string"
              },
              "registers": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "covered",
                  "total"
                ],
                "properties": {
                  "covered": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "instances": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "covered",
                  "total"
                ],
                "properties": {
                  "covered": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "nets": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "covered",
                  "total"
                ],
                "properties": {
                  "covered": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "excluded": {
          "type": "object"
        },
        "uncovered": {
          "type": "object"
        }
      }
    },
    "latency": {
      "description": "Drawn latency along every shown path through a drawn element equals the RTL latency, and no pipeline register is hidden inside a collapsed element (latency/hidden-register).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairs_checked",
        "mismatches",
        "hidden_registers"
      ],
      "properties": {
        "pairs_checked": {
          "type": "integer",
          "minimum": 0
        },
        "pairs_with_registers": {
          "type": "integer",
          "minimum": 0
        },
        "member_pairs_checked": {
          "description": "RTL signal pairs traced, counting each member of a bundle net.",
          "type": "integer",
          "minimum": 0
        },
        "bundled_pairs_checked": {
          "description": "Drawn net pairs where at least one net is a bundle expanded to its members.",
          "type": "integer",
          "minimum": 0
        },
        "pairs_skipped_bundled": {
          "description": "Bundle members that do not resolve to an RTL signal and were not checked.",
          "type": "integer",
          "minimum": 0
        },
        "state_pairs": {
          "description": "Pairs through controller outputs declared latency \"state\" (no single latency claimed; hidden pipeline registers still checked).",
          "type": "integer",
          "minimum": 0
        },
        "excluded_unmapped": {
          "description": "Nets the author drew without an RTL mapping (net rtl_unmapped), with the reason.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["net", "reason"],
            "properties": { "net": { "type": "string" }, "reason": { "type": "string" } }
          }
        },
        "mismatches": {
          "const": 0
        },
        "hidden_registers": {
          "const": 0
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "hidden": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "view": {
      "description": "View preset and scope the figure was delivered at (SPEC §4.8), and any CLI overrides applied to the spec.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset",
        "scope"
      ],
      "properties": {
        "preset": {
          "enum": [
            "overview",
            "block",
            "mixed",
            "detail"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "type": "integer"
        },
        "gate_regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blackbox": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope_module": {
          "type": [
            "string",
            "null"
          ]
        },
        "collapsed_within_depth": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overrides": {
          "type": "object"
        }
      }
    },
    "format": {
      "description": "Output format (lib/format.mjs): paper column variants, or study (one figure sized to content). A study receipt lists the paper-only checks that were skipped or downgraded to warnings, and how often each fired.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "profile",
        "skipped_checks",
        "downgraded_checks"
      ],
      "properties": {
        "name": {
          "enum": [
            "paper",
            "study"
          ]
        },
        "profile": {
          "type": "string"
        },
        "skipped_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "downgraded_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relaxed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "treatment",
              "count"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "treatment": {
                "enum": [
                  "skip",
                  "warning"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "archived": {
      "description": "Superseded outputs of this figure name that were in the output directory, moved before writing (path relative to the output directory).",
      "type": "string"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes",
        "width_pt",
        "height_pt"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "width_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "rtl_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "top",
        "netlist_sha256",
        "rtl_files",
        "crosscheck"
      ],
      "properties": {
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "top": {
          "type": "string"
        },
        "netlist_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rtl_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_hash"
          }
        },
        "blackboxes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module",
              "origin"
            ],
            "properties": {
              "module": {
                "type": "string"
              },
              "origin": {
                "enum": [
                  "user",
                  "auto"
                ]
              }
            }
          }
        },
        "crosscheck": {
          "enum": [
            "pass",
            "fail",
            "not-run"
          ]
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulator",
        "top",
        "stimulus",
        "rtl_files",
        "vcd_sha256",
        "clock",
        "window",
        "signals"
      ],
      "properties": {
        "simulator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "top": {
          "type": "string"
        },
        "stimulus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "files"
          ],
          "properties": {
            "kind": {
              "enum": [
                "sv-testbench",
                "cpp-harness",
                "bfm-script"
              ]
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/file_hash"
              }
            },
            "dpi_models": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/file_hash"
              }
            },
            "seed": {
              "type": "integer"
            }
          }
        },
        "rtl_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file_hash"
          }
        },
        "defines": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "params": {
          "type": "object"
        },
        "vcd_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "edge"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "edge": {
              "enum": [
                "pos",
                "neg"
              ]
            }
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "first_cycle",
            "cycles"
          ],
          "properties": {
            "first_cycle": {
              "type": "integer",
              "minimum": 0
            },
            "cycles": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lane",
              "rtl_path"
            ],
            "properties": {
              "lane": {
                "type": "string"
              },
              "rtl_path": {
                "type": "string"
              }
            }
          }
        },
        "generated_wavejson_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "level",
        "grounding"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "figure",
            "element",
            "block",
            "region",
            "stub",
            "gate-region"
          ]
        },
        "label": {
          "type": "string"
        },
        "level": {
          "enum": [
            "simulated",
            "sim-compared",
            "structural-only",
            "unverified"
          ]
        },
        "grounding": {
          "enum": [
            "rtl",
            "vcd",
            "doc",
            "stub",
            "none"
          ]
        },
        "reason": {
          "type": "string"
        },
        "equivalence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "vectors",
            "result"
          ],
          "properties": {
            "method": {
              "enum": [
                "exhaustive",
                "sampled"
              ]
            },
            "vectors": {
              "type": "integer",
              "minimum": 1
            },
            "seed": {
              "type": "integer"
            },
            "input_bits": {
              "type": "integer",
              "minimum": 0
            },
            "result": {
              "const": "pass"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "level": {
                "const": "structural-only"
              }
            }
          },
          "then": {
            "properties": {
              "grounding": {
                "const": "rtl"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "enum": [
                  "simulated",
                  "sim-compared"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "grounding": {
                "const": "vcd"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "grounding": {
                "enum": [
                  "stub",
                  "doc",
                  "none"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "level": {
                "const": "unverified"
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "required": [
        "level",
        "regions"
      ],
      "properties": {
        "level": {
          "enum": [
            "simulated",
            "sim-compared",
            "structural-only",
            "unverified",
            "mixed"
          ]
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/region"
          }
        },
        "scope_note": {
          "const": "Simulation evidence covers only the recorded stimulus and cycle window."
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "simulation": {
          "type": "object"
        },
        "compare": {
          "type": "object"
        },
        "structural": {
          "type": "object"
        },
        "failed": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "level": {
                "const": "simulated"
              }
            }
          },
          "then": {
            "required": [
              "simulation",
              "scope_note"
            ],
            "properties": {
              "simulation": {
                "allOf": [
                  {
                    "$ref": "#/$defs/simulation"
                  }
                ],
                "required": [
                  "generated_wavejson_sha256"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "sim-compared"
              }
            }
          },
          "then": {
            "required": [
              "simulation",
              "compare",
              "scope_note"
            ],
            "properties": {
              "simulation": {
                "$ref": "#/$defs/simulation"
              },
              "compare": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "compared_cells",
                  "dont_care_cells",
                  "skipped_symbolic_values",
                  "mismatches"
                ],
                "properties": {
                  "compared_cells": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "dont_care_cells": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "skipped_symbolic_values": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "value_map_used": {
                    "type": "boolean"
                  },
                  "mismatches": {
                    "type": "array",
                    "maxItems": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "structural-only"
              }
            }
          },
          "then": {
            "required": [
              "structural"
            ],
            "properties": {
              "structural": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "netlist_sha256",
                  "crosscheck"
                ],
                "properties": {
                  "datapath_figure_sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "netlist_sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "crosscheck": {
                    "const": "pass"
                  },
                  "latencies_checked": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "unverified"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "allOf": [
    {
      "description": "Only a study receipt may omit the PDF of a variant.",
      "if": {
        "not": {
          "required": [
            "format"
          ],
          "properties": {
            "format": {
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "const": "study"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "variants": {
            "items": {
              "required": [
                "pdf"
              ]
            }
          }
        }
      }
    }
  ]
}
