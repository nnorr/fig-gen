{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtl-figures.local/schemas/common.schema.json",
  "title": "rtl-figures shared definitions",
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 64 },
    "width": {
      "description": "Positive integer or width expression over params (identifiers, + - * /, parentheses, clog2(), max()).",
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 65536 },
        { "type": "string", "pattern": "^[A-Za-z0-9_+\\-*/(), ]+$", "minLength": 1, "maxLength": 120 }
      ]
    },
    "sv_literal": { "type": "string", "pattern": "^([0-9]+)?'[sS]?[bBoOdDhH][0-9a-fA-FxXzZ_?]+$|^[0-9]+$" },
    "endpoint": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(/[A-Za-z_][A-Za-z0-9_]*)*(\\.[A-Za-z_][A-Za-z0-9_]*)?(\\[[0-9]+(:[0-9]+)?\\])?$"
    },
    "variant_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "short_label": { "type": "string", "minLength": 1, "maxLength": 40 },
    "label_by_variant": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/variant_id" },
      "additionalProperties": { "enum": ["full", "short"] }
    },
    "net_class": { "enum": ["data", "control", "clock", "reset"] },
    "source_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!\\.git/)[^\\\\\\u0000-\\u001f]+$" },
        "line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "match": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "rtl_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_\\[\\]]*(/[A-Za-z_][A-Za-z0-9_\\[\\]]*)*$" },
        "module": { "type": "string" },
        "signal": { "type": "string" },
        "state_register": { "type": "string" }
      }
    },
    "print": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "variants": { "type": "array", "items": { "$ref": "#/$defs/variant_id" }, "minItems": 1, "uniqueItems": true },
        "max_height_in": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/variant_id" },
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grayscale": { "type": "boolean" },
        "font_family": { "type": "string", "minLength": 1 },
        "font_size_pt": { "type": "number", "minimum": 5, "maximum": 14 },
        "svg_profile": { "enum": ["figma-safe", "print-compact"] },
        "width_labels": { "enum": ["value", "symbolic", "both"] },
        "gates": { "enum": ["distinctive", "rectangular"] },
        "skin": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "mux_style": { "enum": ["bar", "trapezoid"] },
        "mux_indices": { "type": "boolean" },
        "color": { "type": "boolean" },
        "clock_wiring": { "enum": ["implicit", "explicit"] },
        "show_priority": { "type": "boolean" }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "revision"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "print"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "caption": { "type": "string", "maxLength": 600 },
        "print": { "$ref": "#/$defs/print" },
        "style": { "$ref": "#/$defs/style" },
        "repository": { "$ref": "#/$defs/repository" }
      }
    },
    "params": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "type": "integer" }
    }
  }
}
