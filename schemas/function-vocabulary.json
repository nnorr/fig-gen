    "error_locator": {
      "display": "Error locator",
      "short": "Locator",
      "evidence": {
        "description": "error-locator computation from the syndromes: a key-equation solver (Berlekamp-Massey, RiBM, Euclid) or a direct GF division/multiplication for small t",
        "source_all": [
          "inv|div|mul|\\*|/"
        ],
        "cone_all": [
          "multiply"
        ]
      },
      "general": "gf_div"
    },
    "chien_search": {
      "display": "Chien search",
      "short": "Chien search",
      "evidence": {
        "description": "per-position evaluation of the error-locator polynomial (iterative or parallel), each result compared with zero",
        "source_all": [
          "mul|\\*",
          "==\\s*[\\w']*0\\b|!=\\s*[\\w']*0\\b|~\\s*\\|"
        ],
        "cone_all": [
          "multiply-by-constant",
          "compare-zero"
        ]
      },
      "general": "comparator"
    },
    "position_match": {
      "display": "Position match",
      "short": "Position match",
      "evidence": {
        "description": "equality compares of a value against a constant table of field powers, one compare per position",
        "source_all": [
          "==|!=",
          "\\w+\\s*\\[[^\\]]+\\]"
        ],
        "cone_all": [
          "compare-eq"
        ]
      },
      "general": "comparator"
    },
