      "display": "Syndrome calculator",
      "stage_display": "Syndrome calculator",
      "short": "Syndromes",
      "evidence": {
        "description": "evaluation of the received word as a polynomial at the code's roots (e.g. Horner steps: multiply by a constant root, add the next symbol)",
        "source_all": [
