{
  "version": 2,
  "description": "Controlled vocabulary for the functional name of datapath blocks (CONVENTIONS §4.3, SPEC §4.5). `display` is the printed primary name; `qualified` is used when the element gives function.qualifier ({q} is replaced, e.g. GF(2^8)); `short` is a readable word for narrow variants; `stage_display` is the name used with function.stage (\"Syndrome calculator\" + \" (stage 1/2)\"); `glyph` marks operators whose circle glyph is the name (no text). `evidence` declares the RTL structure a figure must cite (function.basis) to use the name: `source_all` regexes must all match the cited source text, and `cone_all` operation categories must all occur in the RTL cone of the block's mapped outputs when a netlist is given. When the evidence is missing or not satisfied, the lint suggests `general`, a more general name. Operation categories: compare-eq, compare-zero, multiply, multiply-by-constant, gf-add, division.",
  "kinds": {
    "gf_add": {
      "display": "GF adder (XOR)",
      "qualified": "{q} adder (XOR)",
      "short": "GF add",
      "glyph": "oplus",
      "evidence": {
        "description": "bitwise XOR (addition in GF(2^m))",
        "source_all": [
          "\\^|xor|add"
        ],
        "cone_all": [
          "gf-add"
        ]
      }
    },
    "gf_mul": {
      "display": "GF multiplier",
      "qualified": "{q} multiplier",
      "short": "GF mul",
      "glyph": "otimes",
      "evidence": {
        "description": "a GF multiplication (multiplier function or shift-and-reduce network)",
        "source_all": [
          "mul|\\*"
        ],
        "cone_all": [
          "multiply"
        ]
      }
    },
    "gf_const_mul": {
      "display": "GF constant multiplier",
      "qualified": "{q} constant multiplier",
      "short": "Constant multiplier",
      "evidence": {
        "description": "multiplication by a constant field element",
        "source_all": [
          "mul|\\*"
        ],
        "cone_all": [
          "multiply-by-constant"
        ]
      },
      "general": "gf_mul"
    },
    "gf_inv": {
      "display": "GF inverter",
      "qualified": "{q} inverter",
      "short": "Inverter"
    },
    "gf_div": {
      "display": "GF divider",
      "qualified": "{q} divider",
      "short": "Divider",
      "evidence": {
        "description": "a GF division or multiplication by an inverse",
        "source_all": [
          "inv|div|/"
        ],
        "cone_all": [
          "division"
        ]
      },
      "general": "gf_mul"
    },
    "gf_poly_eval": {
      "display": "GF polynomial evaluator",
      "qualified": "{q} polynomial evaluator",
      "short": "Polynomial evaluator",
      "evidence": {
        "description": "polynomial evaluation: repeated multiply by a constant point and add the next coefficient (Horner) or a sum of scaled terms",
        "source_all": [
          "mul|\\*",
          "\\^|add|xor"
        ],
        "cone_all": [
          "multiply-by-constant",
          "gf-add"
        ]
      }
    },
    "gf_pow_lut": {
      "display": "GF power LUT",
      "qualified": "{q} power LUT",
      "short": "Power LUT"
