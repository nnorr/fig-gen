{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fig-gen.local/schemas/datapath.schema.json",
  "title": "fig-gen datapath IR (schema_version 1, skeleton)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "figure_type",
    "meta",
    "clock_domains",
    "elements",
    "nets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "figure_type": {
      "const": "datapath"
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/meta"
    },
    "params": {
      "$ref": "common.schema.json#/$defs/params"
    },
    "clock_domains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clock_domain"
      }
    },
    "modules": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/module"
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "nets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/net"
      }
    },
    "latency_unverified": {
      "description": "Explicit opt-out of latency/unverified: the figure draws registers of its scope but no latency pair can be compared (e.g. a pure structure overview). The reason is recorded in the latency report and the receipt; nothing else is relaxed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 12,
          "maxLength": 300
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotation"
      }
    },
    "regions": {
      "description": "Abstraction regions (SPEC §4.6): named groups of elements drawn at one level; gate regions are equivalence-checked against the RTL.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "level",
          "members"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "maxLength": 60
          },
          "short_label": {
            "$ref": "common.schema.json#/$defs/short_label"
          },
          "level": {
            "enum": [
              "blackbox",
              "block",
              "rtl",
              "gate"
            ]
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "parent": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "frame": {
            "type": "boolean"
          },
          "max_gates": {
            "type": "integer",
            "minimum": 1,
            "maximum": 400
          },
          "rtl": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "instance": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_\\[\\]]*(/[A-Za-z_][A-Za-z0-9_\\[\\]]*)*$"
              },
              "stop_at": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "equivalence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "vectors": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "seed": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "view": {
      "description": "View preset (SPEC §4.8): scope and abstraction the figure is delivered at. The scope is the declared scope for coverage; the receipt and caption state the preset and scope.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset"
      ],
      "properties": {
        "preset": {
          "enum": [
            "overview",
            "block",
            "mixed",
            "detail"
          ]
        },
        "scope": {
          "type": "string",
          "pattern": "^$|^[A-Za-z_][A-Za-z0-9_\\[\\]]*(/[A-Za-z_][A-Za-z0-9_\\[\\]]*)*$"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "gate_regions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "blackbox": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "abstract": {
          "description": "Declared abstraction (SPEC §4.11): handshakes true omits every 1-bit handshake net between two drawn blocks from the drawing, with the reason. The nets stay checked; the receipt lists them (coverage.excluded.abstracted_handshakes) and the caption says \"handshake signals omitted\".",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handshakes",
            "reason"
          ],
          "properties": {
            "handshakes": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            }
          }
        }
      }
    }
  },
  "$defs": {
    "clock_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "clock"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "clock": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "period_ns": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "net",
            "active"
          ],
          "properties": {
            "net": {
              "type": "string"
            },
            "active": {
              "enum": [
                "low",
                "high"
              ]
            },
            "async": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "function": {
      "description": "Functional name of a block (CONVENTIONS §4.3). kind comes from schemas/function-vocabulary.json; the printed name defaults to its display name, optionally qualified (e.g. GF(2^8)). detail is an optional small secondary line for algorithm detail (Horner, S2/S1), never the primary name.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "gf_add",
            "gf_mul",
            "gf_const_mul",
            "gf_inv",
            "gf_div",
            "gf_poly_eval",
            "gf_pow_lut",
            "gf_log_lut",
            "gf_antilog_lut",
            "adder",
            "subtractor",
            "multiplier",
            "divider",
            "comparator",
            "zero_detect",
            "shifter",
            "lut",
            "rom",
            "encoder",
            "decoder",
            "syndrome",
            "error_locator",
            "chien_search",
            "position_match",
            "error_evaluator",
            "corrector",
            "classifier",
            "correction_enable",
            "controller",
            "fsm",
            "csr_bank",
            "bus_slave",
            "memory",
            "error_injector",
            "arithmetic_unit",
            "counter",
            "fifo",
            "arbiter",
            "hash",
            "permutation",
            "custom"
          ]
        },
        "qualifier": {
          "type": "string",
          "maxLength": 24
        },
        "detail": {
          "type": "string",
          "maxLength": 40
        },
        "name": {
          "type": "string",
          "maxLength": 40
        },
        "short_name": {
          "type": "string",
          "maxLength": 16
        },
        "stage": {
          "description": "Declares the block as stage k of n of one function (\"1/2\"); the printed name gets \" (stage k/n)\" and label/duplicate accepts the shared name.",
          "type": "string",
          "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"
        },
        "basis": {
          "description": "The RTL structure that justifies the vocabulary name (label/function-justification): a source pin and a short description of the structure it shows.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "$ref": "common.schema.json#/$defs/source_pin"
            },
            "structure": {
              "type": "string",
              "maxLength": 120
            }
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "custom"
          }
        }
      },
      "then": {
        "required": [
          "name"
        ]
      },
      "else": {
        "description": "function.name is printed only for kind custom; on a vocabulary kind write the distinguishing word in qualifier (\"Nonce client\" + controller) and a short_label on the element.",
        "not": {
          "required": [
            "name"
          ]
        }
      }
    },
    "port_def": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dir",
        "width"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "dir": {
          "enum": [
            "in",
            "out",
            "inout"
          ]
        },
        "width": {
          "$ref": "common.schema.json#/$defs/width"
        },
        "class": {
          "$ref": "common.schema.json#/$defs/net_class"
        },
        "side": {
          "enum": [
            "west",
            "east",
            "north",
            "south"
          ]
        },
        "domain": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "registered": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "short_label": {
          "$ref": "common.schema.json#/$defs/short_label"
        },
        "bundle": {
          "description": "Drawn pin that bundles several RTL ports (e.g. one memory-control bus); the boundary check expands it and requires the widths to add up.",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "role": {
          "description": "How the consumer uses this input (CONVENTIONS §1): select, enable (incl. write/chip enable), handshake (valid/ready) make a net control (dashed); value (default) makes it data (solid).",
          "enum": [
            "value",
            "select",
            "enable",
            "handshake"
          ]
        },
        "latency": {
          "description": "Register stages from the inputs to this output. An integer: a registered output (default 1). \"state\": a state (Moore/Mealy) output of a stateful protocol block (controller, FSM, bus slave, CSR bank, arbiter) whose latency depends on the state; no single number is claimed, hidden pipeline registers are still reported. An object {input pin id: stages} (0 = combinational; key \"default\" for the rest): a controller output whose latency differs by input (latency/controller-only), or an output of any block marked holds_state. On a bundled pin the number is the minimum over its members. \"state\" where the netlist shows a fixed latency from an input warns (latency/state-escape).",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            {
              "const": "state"
            },
            {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              }
            }
          ]
        },
        "comb_from": {
          "description": "Output ports: the input pins that reach this output with no register on the way; every other input reaches it only through registers, or not at all. comb/loop follows exactly these (without it, every input of a non-registered output counts as combinational). With a netlist the latency check verifies the list against the RTL (latency/comb-from).",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ports"
      ],
      "properties": {
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port_def"
          }
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "nets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/net"
          }
        },
        "blackbox": {
          "type": "boolean"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/source_pin"
        }
      }
    },
    "layout_hint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "align_with": {
          "$ref": "common.schema.json#/$defs/id"
        }
      }
    },
    "element_common": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "short_label": {
          "$ref": "common.schema.json#/$defs/short_label"
        },
        "labels": {
          "$ref": "common.schema.json#/$defs/label_by_variant"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/source_pin"
        },
        "rtl": {
          "$ref": "common.schema.json#/$defs/rtl_ref"
        },
        "holds_state": {
          "description": "The block holds state (registers with feedback) although its function kind is not a stateful protocol kind: its outputs may declare latency per input pin or \"state\" (latency/controller-only). With a netlist the latency check requires a register with feedback in its rtl.covers or rtl.instance subtree (latency/holds-state).",
          "type": "boolean"
        },
        "layout": {
          "$ref": "#/$defs/layout_hint"
        },
        "detail_ref": {
          "description": "Sub-figure that draws this element in detail ((a)/(b) split of a scope too large for one figure).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "figure"
          ],
          "properties": {
            "figure": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        },
        "show_details": {
          "description": "Opt this block into secondary lines inside its box (stage notes, function.detail, pin labels, sizes) when the figure keeps blocks name-only (meta.style.block_details unset).",
          "type": "boolean"
        }
      }
    },
    "element": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "port",
            "const",
            "mux",
            "comb",
            "register",
            "pipeline_register",
            "memory",
            "synchronizer",
            "instance"
          ]
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/element_common"
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "port"
              }
            }
          },
          "then": {
            "required": [
              "dir",
              "width"
            ],
            "properties": {
              "dir": {
                "enum": [
                  "in",
                  "out",
                  "inout"
                ]
              },
              "width": {
                "$ref": "common.schema.json#/$defs/width"
              },
              "off_page": {
                "description": "A deliberate single-ended off-page reference: the port is drawn without a wire (connector/orphan-tag does not apply).",
                "type": "boolean"
              },
              "connector": {
                "description": "Draw this figure-boundary port as the house off-page arrow tag. Use target for an input whose wire leaves the tag tip, and source for an output whose wire enters the tag back.",
                "enum": [
                  "source",
                  "target"
                ]
              },
              "class": {
                "$ref": "common.schema.json#/$defs/net_class"
              },
              "domain": {
                "type": "string"
              },
              "role": {
                "description": "How the consumer uses this input (CONVENTIONS §1): select, enable (incl. write/chip enable), handshake (valid/ready) make a net control (dashed); value (default) makes it data (solid).",
                "enum": [
                  "value",
                  "select",
                  "enable",
                  "handshake"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "const"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "$ref": "common.schema.json#/$defs/sv_literal"
              },
              "display": {
                "description": "Visual treatment for a local literal. boxed is the default value symbol; label prints the readable value as plain text on its outgoing wire.",
                "enum": [
                  "boxed",
                  "label"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mux"
              }
            }
          },
          "then": {
            "required": [
              "inputs",
              "width"
            ],
            "properties": {
              "inputs": {
                "type": "integer",
                "minimum": 2,
                "maximum": 64
              },
              "width": {
                "$ref": "common.schema.json#/$defs/width"
              },
              "encoding": {
                "enum": [
                  "binary",
                  "onehot"
                ]
              },
              "priority": {
                "type": "boolean"
              },
              "style": {
                "enum": [
                  "bar",
                  "trapezoid"
                ]
              },
              "indices": {
                "type": "boolean"
              },
              "lanes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "input_labels": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[0-9]+$"
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 24
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "comb"
              }
            }
          },
          "then": {
            "required": [
              "op",
              "width"
            ],
            "properties": {
              "op": {
                "enum": [
                  "and",
                  "or",
                  "xor",
                  "nand",
                  "nor",
                  "xnor",
                  "not",
                  "buf",
                  "add",
                  "sub",
                  "mul",
                  "cmp",
                  "shift",
                  "reduce",
                  "concat",
                  "split",
                  "extend",
                  "replicate",
                  "lut",
                  "rom",
                  "custom"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 2
              },
              "width": {
                "$ref": "common.schema.json#/$defs/width"
              },
              "inputs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "out_width": {
                "$ref": "common.schema.json#/$defs/width"
              },
              "cmp": {
                "enum": [
                  "eq",
                  "ne",
                  "lt",
                  "le",
                  "gt",
                  "ge"
                ]
              },
              "signed": {
                "type": "boolean"
              },
              "dir": {
                "enum": [
                  "left",
                  "right",
                  "arith"
                ]
              },
              "reduce": {
                "enum": [
                  "and",
                  "or",
                  "xor"
                ]
              },
              "carry_in": {
                "type": "boolean"
              },
              "carry_out": {
                "type": "boolean"
              },
              "in_widths": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/width"
                }
              },
              "slices": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]+(:[0-9]+)?$"
                }
              },
              "depth": {
                "$ref": "common.schema.json#/$defs/width"
              },
              "contents": {
                "type": "string"
              },
              "pin_labels": {
                "description": "Opt-in pin labels inside the box (CONVENTIONS §4.3, label/pin-clutter). Default off for every block: only pins whose identity is essential (minuend/subtrahend, A/B of a non-commutative op, mux data order) and that carry a readable port label print, at most 4 per block, never clock or reset pins, never RTL pin ids.",
                "type": "boolean"
              },
              "invert_inputs": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "uniqueItems": true
              },
              "invert_output": {
                "type": "boolean"
              },
              "extend": {
                "enum": [
                  "zero",
                  "sign"
                ]
              },
              "function": {
                "$ref": "#/$defs/function"
              },
              "ports": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/port_def"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "comb"
              },
              "op": {
                "const": "custom"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "function"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "register"
              }
            }
          },
          "then": {
            "required": [
              "domain"
            ],
            "properties": {
              "width": {
                "$ref": "common.schema.json#/$defs/width"
              },
              "domain": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "enable": {
                "type": "boolean"
              },
              "reset": {
                "enum": [
                  "none",
                  "async",
                  "sync"
                ]
              },
              "init": {
                "$ref": "common.schema.json#/$defs/sv_literal"
              },
              "style": {
                "enum": [
                  "box",
                  "bar"
                ]
              },
              "lanes": {
                "description": "A register bank: one register per lane (d_<id> in, q_<id> out), drawn as one storage box with a clock wedge. Used for registers that share a role and load pattern (inputs loaded on accept, temporaries, outputs). With lanes, width is not given; enable_width sets the load-enable pin (one bit per register, or 1 when all load together).",
                "type": "array",
                "minItems": 2,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "width"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "common.schema.json#/$defs/id"
                    },
                    "width": {
                      "$ref": "common.schema.json#/$defs/width"
                    },
                    "label": {
                      "type": "string"
                    },
                    "rtl": {
                      "$ref": "common.schema.json#/$defs/rtl_ref"
                    }
                  }
                }
              },
              "enable_width": {
                "description": "Width of the load-enable pin of a register bank (lanes): one bit per independently loaded register, 1 when the bank loads together.",
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "shared_d": {
                "description": "Register bank only: every register loads from one data source (a result bus), drawn as one d input; each register still loads under its own enable bit.",
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "lanes"
                  ]
                },
                "then": {
                  "not": {
                    "required": [
                      "width"
                    ]
                  }
                },
                "else": {
                  "required": [
                    "width"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pipeline_register"
              }
            }
          },
          "then": {
            "required": [
              "lanes",
              "domain"
            ],
            "properties": {
              "domain": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "stage": {
                "type": "integer",
                "minimum": 0
              },
              "enable": {
                "type": "boolean"
              },
              "reset": {
                "enum": [
                  "none",
                  "async",
                  "sync"
                ]
              },
              "lanes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "width"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "common.schema.json#/$defs/id"
                    },
                    "width": {
                      "$ref": "common.schema.json#/$defs/width"
                    },
                    "class": {
                      "$ref": "common.schema.json#/$defs/net_class"
                    },
                    "label": {
                      "type": "string"
                    },
                    "role": {
                      "description": "How the consumer uses this input (CONVENTIONS §1): select, enable (incl. write/chip enable), handshake (valid/ready) make a net control (dashed); value (default) makes it data (solid).",
                      "enum": [
                        "value",
                        "select",
                        "enable",
                        "handshake"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "memory"
              }
            }
          },
          "then": {
            "required": [
              "depth",
              "width",
              "domain",
              "ports"
            ],
            "properties": {
              "depth": {
                "$ref": "common.schema.json#/$defs/width"
              },
              "width": {
                "$ref": "common.schema.json#/$defs/width"
              },
              "domain": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "impl": {
                "enum": [
                  "ff",
                  "inferred",
                  "blackbox",
                  "unknown"
                ]
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "type"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "common.schema.json#/$defs/id"
                    },
                    "type": {
                      "enum": [
                        "read",
                        "write",
                        "rw"
                      ]
                    },
                    "read_latency": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 8
                    },
                    "read_during_write": {
                      "enum": [
                        "write_first",
                        "read_first",
                        "undefined"
                      ]
                    },
                    "we": {
                      "type": "boolean"
                    },
                    "re": {
                      "type": "boolean"
                    },
                    "domain": {
                      "$ref": "common.schema.json#/$defs/id"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "synchronizer"
              }
            }
          },
          "then": {
            "required": [
              "from",
              "to",
              "style",
              "width"
            ],
            "properties": {
              "from": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "to": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "style": {
                "enum": [
                  "ff2",
                  "ff3",
                  "pulse",
                  "handshake",
                  "gray",
                  "async_fifo"
                ]
              },
              "width": {
                "$ref": "common.schema.json#/$defs/width"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "instance"
              }
            }
          },
          "then": {
            "required": [
              "module",
              "function"
            ],
            "properties": {
              "module": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "function": {
                "$ref": "#/$defs/function"
              },
              "params": {
                "$ref": "common.schema.json#/$defs/params"
              },
              "view": {
                "enum": [
                  "collapsed",
                  "expanded"
                ]
              },
              "level": {
                "enum": [
                  "blackbox",
                  "block"
                ]
              },
              "internals": {
                "enum": [
                  "unknown",
                  "stub",
                  "known"
                ]
              },
              "pin_labels": {
                "description": "Opt-in pin labels inside the box (CONVENTIONS §4.3, label/pin-clutter). Default off for every block: only pins whose identity is essential (minuend/subtrahend, A/B of a non-commutative op, mux data order) and that carry a readable port label print, at most 4 per block, never clock or reset pins, never RTL pin ids.",
                "type": "boolean"
              },
              "ports": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/port_def"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "net": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "width",
        "driver",
        "sinks"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "width": {
          "$ref": "common.schema.json#/$defs/width"
        },
        "class": {
          "$ref": "common.schema.json#/$defs/net_class"
        },
        "domain": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "driver": {
          "$ref": "common.schema.json#/$defs/endpoint"
        },
        "sinks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/endpoint"
          }
        },
        "label": {
          "type": "string",
          "maxLength": 40
        },
        "short_label": {
          "$ref": "common.schema.json#/$defs/short_label"
        },
        "labels": {
          "$ref": "common.schema.json#/$defs/label_by_variant"
        },
        "bundle": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/source_pin"
        },
        "rtl": {
          "$ref": "common.schema.json#/$defs/rtl_ref"
        },
        "class_reason": {
          "description": "Required when class differs from the class derived from the sinks (net/class-style).",
          "type": "string",
          "maxLength": 160
        },
        "rtl_unmapped": {
          "description": "The author deliberately draws this net without an RTL mapping; the reason is counted in the receipt (latency.excluded_unmapped) so a reviewer sees where verification is weaker.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            },
            "rtl": {
              "description": "The RTL signal the wire carries, kept for structural checks only: it bounds traced paths and verifies comb_from. No latency or cross-check claim is made on it.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "signal"
              ],
              "properties": {
                "instance": {
                  "type": "string"
                },
                "signal": {
                  "type": "string"
                }
              }
            }
          }
        },
        "label_placement": {
          "description": "Where the net's name may print. inline (default): on its own wire only. leader: on its wire when a spot exists, otherwise in free space joined to the wire by a short orthogonal leader (net_label.leader_max_pt, label/leader-used). auto: the same as leader; the name is inline whenever it fits.",
          "enum": [
            "inline",
            "leader",
            "auto"
          ]
        },
        "leader_max_pt": {
          "description": "Longest leader this net's name may use, overriding the skin's net_label.leader_max_pt (for a name whose nearest free space is further away).",
          "type": "number",
          "minimum": 6,
          "maximum": 60
        },
        "width_label": {
          "description": "A bundle (bundle_of, or a pin bundle) that forms one data word (e.g. data and ECC bytes read as one codeword) is labeled with its width like any multi-bit data net; width/missing then applies. Protocol bundles (AHB, valid/ready groups) leave it off and are drawn without a summed width.",
          "type": "boolean"
        },
        "bundle_of": {
          "description": "Heterogeneous bundle (CONVENTIONS §2.1): the signals this net carries. It is drawn with its name (net label or port label), never with a summed width. Members are RTL signal names of the net's instance (meta.rtl.instance or rtl.instance), or dotted child paths (u_child.port); latency and structural checks expand them.",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "omit": {
          "description": "Leave this 1-bit handshake or control net between two drawn blocks out of the drawing, with the reason (SPEC §4.11). Data nets and nets touching figure ports cannot be omitted.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            }
          }
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "kind": {
          "enum": [
            "label",
            "stage_band",
            "critical_path",
            "latency",
            "legend"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 120
        },
        "short_text": {
          "$ref": "common.schema.json#/$defs/short_label"
        },
        "anchor": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/endpoint"
          }
        },
        "from": {
          "$ref": "common.schema.json#/$defs/endpoint"
        },
        "to": {
          "$ref": "common.schema.json#/$defs/endpoint"
        },
        "cycles": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
