{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtl-figures.local/schemas/datapath.schema.json",
  "title": "rtl-figures datapath IR (schema_version 1, skeleton)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "figure_type", "meta", "clock_domains", "elements", "nets"],
  "properties": {
    "schema_version": { "const": 1 },
    "figure_type": { "const": "datapath" },
    "meta": { "$ref": "common.schema.json#/$defs/meta" },
    "params": { "$ref": "common.schema.json#/$defs/params" },
    "clock_domains": { "type": "array", "items": { "$ref": "#/$defs/clock_domain" } },
    "modules": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/module" }
    },
    "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "nets": { "type": "array", "items": { "$ref": "#/$defs/net" } },
    "annotations": { "type": "array", "items": { "$ref": "#/$defs/annotation" } }
  },
  "$defs": {
    "clock_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "clock"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "clock": { "type": "string" },
        "label": { "type": "string" },
        "period_ns": { "type": "number", "exclusiveMinimum": 0 },
        "reset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["net", "active"],
          "properties": {
            "net": { "type": "string" },
            "active": { "enum": ["low", "high"] },
            "async": { "type": "boolean" }
          }
        }
      }
    },
    "port_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dir", "width"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "dir": { "enum": ["in", "out", "inout"] },
        "width": { "$ref": "common.schema.json#/$defs/width" },
        "class": { "$ref": "common.schema.json#/$defs/net_class" },
        "side": { "enum": ["west", "east", "north", "south"] },
        "domain": { "$ref": "common.schema.json#/$defs/id" },
        "registered": { "type": "boolean" },
        "label": { "type": "string" },
        "short_label": { "$ref": "common.schema.json#/$defs/short_label" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ports"],
      "properties": {
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port_def" } },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } },
        "nets": { "type": "array", "items": { "$ref": "#/$defs/net" } },
        "blackbox": { "type": "boolean" },
        "source": { "$ref": "common.schema.json#/$defs/source_pin" }
      }
    },
    "layout_hint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layer": { "type": "integer", "minimum": 0 },
        "order": { "type": "integer", "minimum": 0 },
        "align_with": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "element_common": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "label": { "type": "string", "maxLength": 80 },
        "short_label": { "$ref": "common.schema.json#/$defs/short_label" },
        "labels": { "$ref": "common.schema.json#/$defs/label_by_variant" },
        "source": { "$ref": "common.schema.json#/$defs/source_pin" },
        "rtl": { "$ref": "common.schema.json#/$defs/rtl_ref" },
        "layout": { "$ref": "#/$defs/layout_hint" }
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "kind": { "enum": ["port", "const", "mux", "comb", "register", "pipeline_register", "memory", "synchronizer", "instance"] }
      },
      "allOf": [
        { "$ref": "#/$defs/element_common" },
        {
          "if": { "properties": { "kind": { "const": "port" } } },
          "then": {
            "required": ["dir", "width"],
            "properties": {
              "dir": { "enum": ["in", "out", "inout"] },
              "width": { "$ref": "common.schema.json#/$defs/width" },
              "class": { "$ref": "common.schema.json#/$defs/net_class" },
              "domain": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "const" } } },
          "then": { "required": ["value"], "properties": { "value": { "$ref": "common.schema.json#/$defs/sv_literal" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "mux" } } },
          "then": {
            "required": ["inputs", "width"],
            "properties": {
              "inputs": { "type": "integer", "minimum": 2, "maximum": 64 },
              "width": { "$ref": "common.schema.json#/$defs/width" },
              "encoding": { "enum": ["binary", "onehot"] },
              "priority": { "type": "boolean" },
              "style": { "enum": ["bar", "trapezoid"] },
              "indices": { "type": "boolean" },
              "lanes": { "type": "integer", "minimum": 1, "maximum": 64 },
              "input_labels": {
                "type": "object",
                "propertyNames": { "pattern": "^[0-9]+$" },
                "additionalProperties": { "type": "string", "maxLength": 24 }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "comb" } } },
          "then": {
            "required": ["op", "width"],
            "properties": {
              "op": { "enum": ["and", "or", "xor", "nand", "nor", "xnor", "not", "buf", "add", "sub", "mul", "cmp", "shift", "reduce", "concat", "split", "lut", "rom", "custom"] },
              "width": { "$ref": "common.schema.json#/$defs/width" },
              "inputs": { "type": "integer", "minimum": 1, "maximum": 64 },
              "out_width": { "$ref": "common.schema.json#/$defs/width" },
              "cmp": { "enum": ["eq", "ne", "lt", "le", "gt", "ge"] },
              "signed": { "type": "boolean" },
              "dir": { "enum": ["left", "right", "arith"] },
              "reduce": { "enum": ["and", "or", "xor"] },
              "carry_in": { "type": "boolean" },
              "carry_out": { "type": "boolean" },
              "in_widths": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/width" } },
              "slices": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+(:[0-9]+)?$" } },
              "depth": { "$ref": "common.schema.json#/$defs/width" },
              "contents": { "type": "string" },
              "ports": { "type": "array", "items": { "$ref": "#/$defs/port_def" } }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "register" } } },
          "then": {
            "required": ["width", "domain"],
            "properties": {
              "width": { "$ref": "common.schema.json#/$defs/width" },
              "domain": { "$ref": "common.schema.json#/$defs/id" },
              "enable": { "type": "boolean" },
              "reset": { "enum": ["none", "async", "sync"] },
              "init": { "$ref": "common.schema.json#/$defs/sv_literal" },
              "style": { "enum": ["box", "bar"] }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "pipeline_register" } } },
          "then": {
            "required": ["lanes", "domain"],
            "properties": {
              "domain": { "$ref": "common.schema.json#/$defs/id" },
              "stage": { "type": "integer", "minimum": 0 },
              "enable": { "type": "boolean" },
              "reset": { "enum": ["none", "async", "sync"] },
              "lanes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "width"],
                  "properties": {
                    "id": { "$ref": "common.schema.json#/$defs/id" },
                    "width": { "$ref": "common.schema.json#/$defs/width" },
                    "class": { "$ref": "common.schema.json#/$defs/net_class" },
                    "label": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "memory" } } },
          "then": {
            "required": ["depth", "width", "domain", "ports"],
            "properties": {
              "depth": { "$ref": "common.schema.json#/$defs/width" },
              "width": { "$ref": "common.schema.json#/$defs/width" },
              "domain": { "$ref": "common.schema.json#/$defs/id" },
              "impl": { "enum": ["ff", "inferred", "blackbox", "unknown"] },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "type"],
                  "properties": {
                    "id": { "$ref": "common.schema.json#/$defs/id" },
                    "type": { "enum": ["read", "write", "rw"] },
                    "read_latency": { "type": "integer", "minimum": 0, "maximum": 8 },
                    "read_during_write": { "enum": ["write_first", "read_first", "undefined"] },
                    "we": { "type": "boolean" },
                    "re": { "type": "boolean" },
                    "domain": { "$ref": "common.schema.json#/$defs/id" }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "synchronizer" } } },
          "then": {
            "required": ["from", "to", "style", "width"],
            "properties": {
              "from": { "$ref": "common.schema.json#/$defs/id" },
              "to": { "$ref": "common.schema.json#/$defs/id" },
              "style": { "enum": ["ff2", "ff3", "pulse", "handshake", "gray", "async_fifo"] },
              "width": { "$ref": "common.schema.json#/$defs/width" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "instance" } } },
          "then": {
            "required": ["module"],
            "properties": {
              "module": { "$ref": "common.schema.json#/$defs/id" },
              "params": { "$ref": "common.schema.json#/$defs/params" },
              "view": { "enum": ["collapsed", "expanded"] },
              "ports": { "type": "array", "items": { "$ref": "#/$defs/port_def" } }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "net": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "driver", "sinks"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "width": { "$ref": "common.schema.json#/$defs/width" },
        "class": { "$ref": "common.schema.json#/$defs/net_class" },
        "domain": { "$ref": "common.schema.json#/$defs/id" },
        "driver": { "$ref": "common.schema.json#/$defs/endpoint" },
        "sinks": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/endpoint" } },
        "label": { "type": "string", "maxLength": 40 },
        "short_label": { "$ref": "common.schema.json#/$defs/short_label" },
        "labels": { "$ref": "common.schema.json#/$defs/label_by_variant" },
        "bundle": { "$ref": "common.schema.json#/$defs/id" },
        "source": { "$ref": "common.schema.json#/$defs/source_pin" },
        "rtl": { "$ref": "common.schema.json#/$defs/rtl_ref" }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "kind": { "enum": ["label", "stage_band", "critical_path", "latency", "legend"] },
        "text": { "type": "string", "maxLength": 120 },
        "short_text": { "$ref": "common.schema.json#/$defs/short_label" },
        "anchor": { "type": "string" },
        "path": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/endpoint" } },
        "from": { "$ref": "common.schema.json#/$defs/endpoint" },
        "to": { "$ref": "common.schema.json#/$defs/endpoint" },
        "cycles": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
